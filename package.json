{
	"name": "next-music-website",
	"private": true,
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "npx serve@latest out",
		"fetch-meta": "pnpm exec tsx scripts/fetch-track-meta.ts",
		"fetch-experiments": "pnpm exec tsx scripts/fetch-experiments.ts",
		"prebuild": "pnpm run fetch-meta && pnpm run fetch-experiments",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.117.3",
		"browser-id3-writer": "^6.4.0",
		"lucide-react": "^1.52.0",
		"marked": "^18.1.0",
		"next": "^16.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^10.12.0",
		"eslint-config-next": "^16.4.0",
		"prettier": "^3.9.9",
		"sass": "^1.105.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
