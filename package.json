{
	"name": "next-music-website",
	"private": true,
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "npx serve@latest out",
		"fetch-meta": "pnpm exec tsx scripts/fetch-track-meta.ts",
		"fetch-experiments": "pnpm exec tsx scripts/fetch-experiments.ts",
		"prebuild": "pnpm run fetch-meta && pnpm run fetch-experiments",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@next/env": "^16.4.6",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-select": "^2.4.1",
		"@supabase/supabase-js": "2.119.2",
		"@tanstack/react-query": "^5.108.1",
		"@tanstack/react-virtual": "^3.14.26",
		"browser-id3-writer": "6.4.0",
		"isomorphic-dompurify": "4.8.0",
		"lucide-react": "1.76.0",
		"marked": "18.2.1",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "10.15.0",
		"eslint-config-next": "16.4.6",
		"prettier": "3.10.1",
		"sass": "1.108.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	}
}
