{
	"name": "next-music-website",
	"private": true,
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "npx serve@latest out",
		"fetch-meta": "pnpm exec tsx scripts/fetch-track-meta.ts",
		"fetch-experiments": "pnpm exec tsx scripts/fetch-experiments.ts",
		"prebuild": "pnpm run fetch-meta && pnpm run fetch-experiments",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@next/env": "^16.4.0",
		"@radix-ui/react-dialog": "^1.2.0",
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"@radix-ui/react-popover": "^1.2.0",
		"@radix-ui/react-select": "^2.3.8",
		"@supabase/supabase-js": "2.117.3",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-virtual": "^3.14.13",
		"browser-id3-writer": "6.4.0",
		"isomorphic-dompurify": "4.5.0",
		"lucide-react": "1.52.0",
		"marked": "18.1.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"eslint": "10.12.0",
		"eslint-config-next": "16.4.0",
		"prettier": "3.9.9",
		"sass": "1.105.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	}
}
