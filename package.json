{
	"name": "next-music-website",
	"private": true,
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "npx serve@latest out",
		"fetch-meta": "pnpm exec tsx scripts/fetch-track-meta.ts",
		"fetch-experiments": "pnpm exec tsx scripts/fetch-experiments.ts",
		"prebuild": "pnpm run fetch-meta && pnpm run fetch-experiments",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.108.2",
		"browser-id3-writer": "^6.3.1",
		"lucide-react": "^1.18.0",
		"marked": "^18.0.5",
		"music-metadata-browser": "^2.5.11",
		"next": "^16.2.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@types/node": "^25",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.5.0",
		"eslint-config-next": "^16.2.9",
		"postcss": "^8.5.15",
		"prettier": "^3.8.4",
		"sass": "^1.101.0",
		"tsx": "^4.22.4",
		"typescript": "^6"
	}
}
